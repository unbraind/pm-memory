  "npm run test:install",project,codex-sol,"2026-11-19T14:11:15.631Z",local_mutation,feat/recall-freshness
  "git fetch --tags origin && npm run changelog:full && npm run changelog:check",project,codex-sol,"2026-11-19T14:11:28.942Z",local_mutation,feat/recall-freshness
  "PM_TEST_TIME_SCALE=3 npm run test:install",project,codex-sol,"2026-11-19T14:36:30.057Z",local_mutation,feat/recall-freshness
  PM_TEST_DEPTH=quick PM_TEST_TIME_SCALE=3 node --import ./test/support/file-deadline.ts --test --test-concurrency=2 test/task-recall.test.ts test/content-age.test.ts test/native-host.test.ts,project,codex-sol,"2026-11-19T19:36:34.414Z",local_mutation,feat/recall-freshness
