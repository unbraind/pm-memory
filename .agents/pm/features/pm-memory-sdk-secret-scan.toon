  "node --test --test-concurrency=1 --test-name-pattern=\"shared scanner and stronger\" test/sdk-adoption.test.ts",project,60,codex-sol,"2026-11-06T10:31:53.768Z",local_mutation,adopt-sdk-transaction-readers-and-secret-scan
